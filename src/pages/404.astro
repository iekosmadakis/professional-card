---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";

import '../styles/projects.css';
---

<BaseLayout
  title="Page Not Found | Ioannis E. Kosmadakis"
  description="The page you are looking for does not exist. Head back to the homepage or browse the projects of Ioannis E. Kosmadakis."
  noindex={true}
>
  <div class="container">
    <div class="projects-container">
      <div class="projects-header">
        <h1>404 &mdash; Page Not Found</h1>
        <p>The page you are looking for does not exist or has been moved. Use the links below to get back on track.</p>
      </div>

      <div class="back-home">
        <a href="/projects" class="back-link">
          <Icon name="folder" />
          My Projects
        </a>
        <a href="/" class="back-link">
          <Icon name="arrow-left" />
          Back to Home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
